# Frontend (public values; safe in the browser). Copy to .env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets. NEVER put these in frontend env.
# Set them as Supabase Edge Function secrets with `npx supabase secrets set NAME=value`.
#   SUPABASE_SERVICE_ROLE_KEY          (send-notifications only)
#   OPENROUTER_API_KEY                 (placeholder: <your-openrouter-key>)
#   OPENROUTER_MODEL                   (recommended: openrouter/free)
#   OPENROUTER_FALLBACK_MODELS         (optional; comma-separated free ":free" model IDs, e.g. <vendor>/<model>:free)
#   EMAIL_PROVIDER_API_KEY             (optional, email notifications)
